{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=crmdev.db"
  },
  "JwtSettings": {
    "SecretKey": "your-super-secret-key-that-is-at-least-32-characters-long",
    "Issuer": "CRMAgent",
    "Audience": "CRMAgentUsers",
    "ExpiryHours": 24
  },
  "GeminiSettings": {
    "ApiKey": "REPLACE_WITH_YOUR_GEMINI_API_KEY",
    "ModelEndpoint": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent"
  },
  "ResendSettings": {
    "ApiKey": "YOUR_RESEND_KEY_HERE",
    "FromEmail": "support@yourcompany.com",
    "InboundSecret": "placeholder"
  },
  "TelegramSettings": {
    "BotToken": "placeholder",
    "WebhookSecret": "placeholder"
  },
  "HangfireSettings": {
    "DailyJobHour": 8,
    "DailyJobMinute": 0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
