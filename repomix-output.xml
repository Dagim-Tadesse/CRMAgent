    opacity: isDragging ? 0.5 : 1
  };

  return (
    <div
      ref={setNodeRef}
      style={style}
      {...listeners}
      {...attributes}
      onClick={() => onClick?.(lead.id)}
      className={`bg-[#14141a] border border-white/5 rounded-2xl p-4 hover:border-white/10 transition-all ${
