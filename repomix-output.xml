    assignedTo: 'John Doe',
    recurring: false
  });

  const [selectedTags, setSelectedTags] = useState([]);
  const [tagInput, setTagInput] = useState('');

  useEffect(() => {
    if (event) {
      setFormData({
        title: event.title || '',
        lead: event.lead || '',
        leadEmail: event.leadEmail || '',
        leadPhone: event.leadPhone || '',
        company: event.company || '',
        type: event.type || 'Demo',
