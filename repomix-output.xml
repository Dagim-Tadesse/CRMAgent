            <div className="space-y-2">
              {getFilteredEvents()
                .filter(e => e.start > new Date() && e.status !== 'Cancelled')
                .sort((a, b) => a.start - b.start)
                .slice(0, 5)
                .map(event => (
                  <div
                    key={event.id}
